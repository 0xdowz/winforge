[
  {
    "id": "TWEAK_CLEAN_001",
    "name": "Windows Temp Folder Cache Cleaner",
    "description": "Cleans temporary files from C:\\Windows\\Temp without deleting system files.",
    "category": "CLEANUP",
    "risk_level": "LOW",
    "risk_score": 10,
    "risk_category": "SAFE",
    "schema_version": "2.0.0",
    "supported_windows_versions": ["10", "11"],
    "requires_admin": true,
    "requires_reboot": false,
    "performance_gain_estimate": "Low",
    "user_visible_change": "Disk Space Reclaimed",
    "technician_only": false,
    "detection_logic": {
      "type": "folder_size",
      "path": "C:\\Windows\\Temp",
      "threshold_mb": 100
    },
    "apply_method": {
      "type": "folder_clean",
      "target_dir": "C:\\Windows\\Temp",
      "safe_file_extensions": [".tmp", ".log", ".bak", ".chk"]
    },
    "rollback_method": {
      "type": "none",
      "note": "Temporary file deletion is non-reversible by nature."
    },
    "verification_method": {
      "type": "folder_size_below",
      "path": "C:\\Windows\\Temp",
      "target_mb": 10
    }
  },
